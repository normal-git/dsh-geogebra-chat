{
  "name": "@normal-git/dsh-geogebra-chat",
  "version": "0.1.1",
  "description": "DSH GeoGebra Chat: immutable, interactive GeoGebra snapshot boards inside DeepSeek Harness conversations.",
  "displayName": "DSH GeoGebra Chat",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/normal-git/dsh-geogebra-chat.git"
  },
  "homepage": "https://github.com/normal-git/dsh-geogebra-chat#readme",
  "bugs": {
    "url": "https://github.com/normal-git/dsh-geogebra-chat/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "geogebra",
    "plugin",
    "math",
    "education"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1"
  }
}
