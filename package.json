{
  "name": "@normal-git/dsh-geogebra-chat",
  "version": "0.1.0",
  "description": "DSH GeoGebra Chat: immutable, interactive GeoGebra snapshot boards inside DeepSeek Harness conversations.",
  "displayName": "DSH GeoGebra Chat",
  "private": false,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "geogebra",
    "plugin",
    "math",
    "education"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1"
  }
}
